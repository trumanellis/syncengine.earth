[Unit]
Description=SyncEngine deploy webhook (GitHub push -> git pull)
Documentation=https://github.com/trumanellis/syncengine.earth/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=truman
EnvironmentFile=/etc/syncengine-deploy.env
ExecStart=/usr/bin/python3 /var/www/syncengine/deploy/webhook.py
Restart=on-failure
RestartSec=3

# Hardening: the service only needs to write the checkout it deploys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/syncengine

[Install]
WantedBy=multi-user.target
