# Caddy site blocks — reference for the /_deploy wiring in /etc/caddy/Caddyfile
# on the relay box. Every auto-deployed sibling site gets the SAME handler,
# reverse-proxying GitHub webhook POSTs to the one multi-site webhook service on
# 127.0.0.1:9000. The service tells sites apart by the Host header (Caddy passes
# it through), so the handler is identical across sites. handle blocks are
# first-match, so /_deploy never falls through to the file server.

# syncengine.earth serves extensionless URLs (/join, not /join.html). The pages
# are still plain .html files on disk; try_files maps the clean URL onto them,
# and old .html URLs 301 to the clean form so shared links and Stripe's
# return_url keep working. Wrapped in `route` because Caddy's default directive
# order would otherwise run try_files before redir and the .html URLs would
# serve directly instead of redirecting — two URLs for every page.
syncengine.earth, www.syncengine.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}
	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}

	# App downloads (the .dmg/.apk + pick-your-platform page). Served from a
	# non-git dir so the large binaries stay out of the repo and auto-deploy.
	# DOWNLOAD_ARTIFACT_URL (donation gateway) points at https://syncengine.earth/get/.
	# Matched before the catch-all handle, so the .html rules below never see it.
	redir /get /get/
	handle_path /get/* {
		root * /var/www/downloads
		file_server
	}

	handle {
		root * /var/www/syncengine
		route {
			# /index.html -> /  and  /articles/index.html -> /articles/
			@indexhtml path_regexp idx ^(.*/)?index\.html$
			redir @indexhtml {re.idx.1} 301

			# /join.html -> /join  (two matchers so a query-less URL
			# doesn't pick up a trailing "?")
			@htmlq {
				path_regexp oldhtml ^/(.*)\.html$
				expression {query} != ""
			}
			redir @htmlq /{re.oldhtml.1}?{query} 301
			@htmlnq {
				path_regexp oldhtml2 ^/(.*)\.html$
				expression {query} == ""
			}
			redir @htmlnq /{re.oldhtml2.1} 301

			# /join -> join.html on disk
			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}

agualila.earth, www.agualila.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}
	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/agualila
		file_server
	}
}

# Abridged — this block exists here only to show the /_deploy wiring. The
# authoritative version (extensionless URLs, /mats short link, the checkout and
# api subdomains) lives in templesofrefuge.earth/infra/Caddyfile; edit it there.
# templesof.earth is the shorter domain the site is migrating to; both names are
# served off the one /var/www/templesofrefuge checkout so they cannot drift.
templesofrefuge.earth, www.templesofrefuge.earth, templesof.earth, www.templesof.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}
	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/templesofrefuge
		file_server
	}
}
