# Caddy site blocks — reference for the /_deploy wiring in /etc/caddy/Caddyfile
# on the relay box. Every auto-deployed sibling site gets the SAME handler,
# reverse-proxying GitHub webhook POSTs to the one multi-site webhook service on
# 127.0.0.1:9000. The service tells sites apart by the Host header (Caddy passes
# it through), so the handler is identical across sites. handle blocks are
# first-match, so /_deploy never falls through to the file server.

syncengine.earth, www.syncengine.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}
	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/syncengine
		file_server
	}
}

agualila.earth, www.agualila.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}
	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/agualila
		file_server
	}
}
